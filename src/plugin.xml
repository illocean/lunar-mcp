<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <!--
     The transport component is an OSGi Declarative Services immediate component declared in
     OSGI-INF/, not an extension point, so it is not registered here. This file exists for the
     tool contribution mechanism only.

     riskTier is declared here as well as on the tool class, and the registry refuses a
     contribution where the two disagree. That is not belt-and-braces: a tier that can differ
     between the bundle's intent and the value published in tools/list is a declaration nobody can
     rely on, and P8 generates the per-agent tools map from that published value.
   -->
   <extension-point id="tools" name="LUNAR Tools"/>

   <extension point="com.github.lunar.core.tools">
      <tool
            class="com.github.lunar.tools.ListProjects"
            riskTier="read"/>
   </extension>
</plugin>
