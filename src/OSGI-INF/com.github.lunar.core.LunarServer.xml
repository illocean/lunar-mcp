<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hand-written because there is no bnd pass. Felix SCR resolves this file only because
  MANIFEST.MF names it in Service-Component.

  The namespace must be one Felix SCR recognises (scr/v1.0.0 .. v1.5.0); anything else parses
  to zero components and the server silently never starts.

  activate/deactivate/init/modified are ATTRIBUTES of <component>, not child elements. As a child
  element the element is ignored, so deactivate never runs and the port stays bound after a restart.

  The workspace reference is the fix for a start-level ordering defect, and it is deliberately a
  MANDATORY, DYNAMIC reference rather than a guard in the constructor. The constructor calls
  ResourcesPlugin.getWorkspace() and starts the listener, and the throw escaped the constructor, so
  SCR marked a singleton component permanently failed with no retry, and the port never opened.
  Declaring the reference is the only thing that actually orders activation: an immediate component
  with an unsatisfied mandatory reference is held back until the service is there. An optional
  reference would not hold it back, and a static one would bind once and never track a workspace that
  appears later. field-option=none because the component never injects the service; it only has to
  wait for it.
-->
<component name="com.github.lunar.core.LunarServer"
           immediate="true"
           deactivate="deactivate"
           xmlns="http://www.osgi.org/xmlns/scr/v1.3.0">
  <service>
    <provide interface="com.github.lunar.LunarServer"/>
  </service>
  <implementation class="com.github.lunar.LunarServer"/>
  <reference name="workspace"
             interface="org.eclipse.core.resources.IWorkspace"
             cardinality="1..1"
             policy="dynamic"
             field-option="none"/>
</component>
